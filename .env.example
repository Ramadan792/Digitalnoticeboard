# Base URL for the API, read via import.meta.env.VITE_API_URL in NewsContext.jsx.
#
# Leave this UNSET (or copy this file to .env and leave the value blank) in
# almost every case: both `vercel dev` locally and a real Vercel deployment
# serve the frontend and the /api functions from the same origin, so a
# relative "/api/notices" path already works with no configuration.
#
# Only set this if you're hosting the frontend somewhere separate from the
# API (e.g. frontend on Netlify, API still on Vercel) — point it at the
# full origin of wherever the API is deployed, no trailing slash:
# VITE_API_URL=https://your-project.vercel.app
VITE_API_URL=
